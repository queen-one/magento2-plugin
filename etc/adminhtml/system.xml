<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="checkout">
            <tab>sales</tab>
            <resource>Magento_Checkout::checkout</resource>
            <group id="queen_one_connect" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Queen One Connect</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Publishes storefront activity through Queen One. Order tracking is delivered separately.</comment>
                </field>
                <field id="site_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Site ID</label>
                    <comment>Required when storefront or backend tracking is enabled.</comment>
                </field>
                <field id="tag_url" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tag URL</label>
                    <validate>required-entry</validate>
                    <backend_model>Rejoiner\Acr\Model\System\Config\Backend\TagUrl</backend_model>
                    <comment>Use the HTTPS installation URL provided for your Queen One environment.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="debug" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="backend_enabled" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Backend Order Delivery Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Independent of storefront tracking. After configuring credentials, activate each store with bin/magento queenone:orders activate STORE_ID. No history is sent automatically.</comment>
                </field>
                <field id="bridge_url" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Bridge Base URL</label>
                    <comment>HTTPS origin/base path, without /webhooks/events. Use your provisioned environment.</comment>
                </field>
                <field id="integration_id" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Bridge Integration ID</label>
                </field>
                <field id="hmac_secret" translate="label comment" type="obscure" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Backend HMAC Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Unique 64-character hexadecimal installation secret. Never a buyer token or catalog token.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
